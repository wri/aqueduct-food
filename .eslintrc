{
  "env": {
    "browser": true,
    "node": true,
    "mocha": true,
    "es6": true
  },
  "globals": {
    "L": true,
    "config": true
  },
  "parser": "babel-eslint",
  "parserOptions": {
    "ecmaVersion": 7,
    "ecmaFeatures": {
      "jsx": true
    },
    "sourceType": "module"
  },
  "plugins": [
    "babel"
  ],
  "extends": "vizzuality",
  "rules": {
    "react/jsx-one-expression-per-line": 0,
    "react/forbid-prop-types": 0,
    "max-len": ["error", { "code": 200 }],
    "camelcase": 0,
    "import/no-extraneous-dependencies": ["error", {
      "devDependencies": [
        "config/webpack/**",
        "**/*.test.js",
        "**/*.spec.js"
      ]
    }]
  },
  "settings": {
    "import/resolver": {
      "webpack": {
        "config": "config/webpack/webpack.config.js"
      }
    }
  }
}
